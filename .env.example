# ==============================================================================
# ZALO-FLOW CONFIGURATION (Open-Source Community Edition)
# ==============================================================================

# Server Settings
PORT=3000
HOST=0.0.0.0

# Security: Passphrase to encrypt Zalo session on local disk (Min 16 chars)
SESSION_SECRET=change-this-to-a-secure-random-passphrase-32-chars

# Security: Token to authenticate Admin REST API / SSE (Leave empty for local dev mode)
ADMIN_API_TOKEN=

# ------------------------------------------------------------------------------
# ADAPTER CONFIGURATIONS
# ------------------------------------------------------------------------------

# [Adapter] Chatwoot (Omnichannel Inbound & Outbound Sync)
# URL of your Chatwoot instance (e.g. https://app.chatwoot.com or https://chatwoot.yourdomain.com)
CHATWOOT_API_URL=
# Chatwoot User API Access Token (found in Profile Settings -> Access Token)
CHATWOOT_API_TOKEN=
# Chatwoot Account ID (integer, found in URL: /app/accounts/{account_id})
CHATWOOT_ACCOUNT_ID=
# Chatwoot API Channel Inbox ID
CHATWOOT_INBOX_ID=

# [Adapter] Generic Webhook (Forward inbound messages to n8n, Dify, Flowise, Make)
GENERIC_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# ANTI-BAN & SAFETY GUARDRAILS (Recommended defaults)
# ------------------------------------------------------------------------------
RATE_LIMIT_PER_SECOND=0.33
RATE_LIMIT_PER_MINUTE=20
FLOOD_THRESHOLD=5
FLOOD_MUTE_SECONDS=60
SELF_ECHO_TTL_SECONDS=30

# ------------------------------------------------------------------------------
# AI ENGINE & AUTO-REPLY (Optional: Gemini, DeepSeek, Z.AI, Groq, OpenAI, Ollama)
# ------------------------------------------------------------------------------
# AI Provider: gemini | deepseek | zai | groq | openai | openrouter | ollama
AI_PROVIDER=gemini
# Primary API Key (Can also be configured securely in Web UI Tab 3)
AI_API_KEY=
# Execution Model
AI_MODEL=gemini-2.5-flash
# Fallback API Key (Optional)
AI_FALLBACK_API_KEY=
# Local Ollama URL (Only if AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# SELF-HEALING MEMORY WATCHDOG (Audit v2)
# ------------------------------------------------------------------------------
# RAM limit in MB before graceful auto-restart (default: 150, Docker limit is 256M)
MAX_MEMORY_MB=150
# Enable or disable Memory Guard sentinel (default: true)
MEMORY_GUARD_ENABLED=true

