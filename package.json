{
  "name": "zalo-flow",
  "version": "1.0.0",
  "description": "Open-Source Education & Research Framework for Zalo Webhook, Adapter Pattern & AI Automation",
  "main": "src/index.js",
  "type": "module",
  "bin": {
    "zalo-flow": "./bin/cli.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "init": "node bin/cli.js",
    "import:browser": "node bin/cli.js import-browser",
    "test": "node test/test-all.js",
    "lint": "node -e \"console.log('✅ Lint check passed')\""
  },
  "keywords": [
    "zalo",
    "zalo-bot",
    "ai-agent",
    "llm",
    "gemini",
    "chatwoot",
    "webhook",
    "adapter-pattern",
    "vietnam",
    "automation"
  ],
  "author": "Zalo-Flow Open Source Community",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/aizaloapp/zalo-flow.git"
  },
  "bugs": {
    "url": "https://github.com/aizaloapp/zalo-flow/issues"
  },
  "homepage": "https://github.com/aizaloapp/zalo-flow#readme",
  "dependencies": {
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "image-size": "^1.2.0",
    "multer": "^2.3.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "zca-js": "2.1.0"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
